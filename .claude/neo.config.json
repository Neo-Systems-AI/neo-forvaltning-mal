{
  "version": 1,
  "neo": {
    "environments": ["sandkasse", "produksjon"],
    "defaultEnv": "sandkasse",
    "byEnv": {
      "sandkasse": {
        "mcpServer": "neo-sandkasse",
        "url": "https://<neo-adresse>",
        "apiClient": {
          "clientId": "<klient-id for maskinklienten i sandkassen>",
          "clientSecret": { "$env": "NEO_SANDKASSE_KLIENT_HEMMELIGHET", "kilde": "<hvelvet og navnet>" }
        }
      },
      "produksjon": { "mcpServer": "neo-produksjon", "url": "https://<neo-adresse>" }
    }
  }
}
