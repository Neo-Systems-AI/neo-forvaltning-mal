{
  "version": 1,
  "hvelv": "<hvelv>",
  "neo": {
    "environments": ["sandkasse", "produksjon"],
    "defaultEnv": "sandkasse",
    "byEnv": {
      "sandkasse": {
        "mcpServer": "neo-sandkasse",
        "url": "https://<neo-adresse>",
        "apiClient": { "clientId": "<klient-id for maskinklienten i sandkassen>" }
      },
      "produksjon": { "mcpServer": "neo-produksjon", "url": "https://<neo-adresse>" }
    }
  }
}
